# SP1 proving config for the functional tests.
#
# Copy this to `sp1-env.bash` and fill in the values (notably NETWORK_PRIVATE_KEY).
# `run_test.sh` sources `sp1-env.bash` when it exists, so its mere presence opts the
# run into SP1 proving against an externally-managed regtest bitcoind. Delete the file
# to return to default (native-proof, self-spawned bitcoind) runs. Every value uses
# ${VAR:-default} so you can still override any of them inline on the command.

# --- SP1 bridge proving ---
export BRIDGE_PROOF_SP1=${BRIDGE_PROOF_SP1:-1}
export SP1_PROVER=${SP1_PROVER:-network}              # mock | cpu | cuda | network
export SP1_PROOF_STRATEGY=${SP1_PROOF_STRATEGY:-reserved}
export NETWORK_RPC_URL=${NETWORK_RPC_URL:-https://rpc.production.succinct.xyz}
export NETWORK_PRIVATE_KEY=${NETWORK_PRIVATE_KEY:-}   # required for SP1_PROVER=network

# Real SP1 Groth16 ASM+Moho proving: build the asm/moho guest ELFs and run the
# asm-runner's SP1 backend so the bridge verifies Groth16 proofs (Sp1Groth16 predicates).
# Set 0 to fall back to native Schnorr attestations (Bip340Schnorr) for the ASM/Moho layer.
export BRIDGE_PROOF_SP1_ASM=${BRIDGE_PROOF_SP1_ASM:-1}

# Under the bundled toy circuit the freshly built counterproof ELF never matches that
# circuit's zero vkey, so the bridge startup checks have to be skipped (see
# _dev_mode_from_env, STR-3889). MOSAIC_CIRCUIT_MODE=full generates the circuit FROM this
# run's counterproof vkey, so the check passes on its merits — set this to 0 there and get
# the startup checks as free coverage.
export BRIDGE_DEV_MODE=${BRIDGE_DEV_MODE:-1}

# --- Mosaic circuit ---
# mock (default): the bundled 768 KB toy circuit, whose output is just the LSB of the game
#   index — it never looks at the counterproof, so NACK-ability is decided by deposit-index
#   parity rather than by whether the counterproof is valid.
# full: generate the REAL g16 SP1-Groth16 verifier circuit (~11.17 B gates, 134 GB) from
#   this run's counterproof vkey and point mosaic at it. Only in this mode is a
#   counterproof actually adjudicated on its merits. Required by tests/full_mosaic.
#   Disk is the binding constraint, not RAM or CPU — see G16_MIN_FREE_GB below and the
#   measured costs in README.md's "Full mosaic circuit mode".
#
# This selects the CIRCUIT ARTIFACT only; cut-and-choose is the separate
# MOSAIC_CUT_AND_CHOOSE axis below.
export MOSAIC_CIRCUIT_MODE=${MOSAIC_CIRCUIT_MODE:-mock}

# Cut-and-choose parameters, an axis INDEPENDENT of the circuit above: `reduced` builds
# mosaic with --features=reduced-circuits (N_CIRCUITS/N_OPEN_CIRCUITS = 5/3, ~3-bit
# soundness), `full` restores 181/174 and 40-bit soundness. Disk and time costs are in
# README.md, "Full mosaic circuit mode".
export MOSAIC_CUT_AND_CHOOSE=${MOSAIC_CUT_AND_CHOOSE:-reduced}

# g16 circuit generation knobs, full mode only (see g16-setup.bash):
#   G16_REF        alpenlabs/g16 ref; default is G16_DEFAULT_REF in circuit-gen.yml
#   G16_DIR        reuse an existing g16 checkout instead of cloning into .g16-src
#   G16_RUNS_DIR   where the pipeline writes the circuit; default _dd/.g16-runs
export G16_REF=${G16_REF:-}
export G16_DIR=${G16_DIR:-}
export G16_RUNS_DIR=${G16_RUNS_DIR:-}
# Disk preflight in GB, checked before generation starts. Covers the circuit itself plus
# the garbled tables and FoundationDB that share the mount during the test phase.
export G16_MIN_FREE_GB=${G16_MIN_FREE_GB:-600}

# Build a SECOND, deliberately stale guest ELF pair from the bundled stub params, so a
# watchtower can be made to emit a counterproof that does not verify under the canonical
# counterproof predicate. Costs one extra guest build plus two SP1 setup() calls; only
# tests/full_mosaic/fn_invalid_counterproof_nackd.py needs it.
export BRIDGE_PROOF_SP1_STALE_ARTIFACTS=${BRIDGE_PROOF_SP1_STALE_ARTIFACTS:-0}

# --- External regtest bitcoind (network-extbtc env) ---
export BRIDGE_EXTERNAL_BITCOIN=${BRIDGE_EXTERNAL_BITCOIN:-1}
export BITCOIN_RPC_URL=${BITCOIN_RPC_URL:-http://127.0.0.1:18443}
export BITCOIN_RPC_USER=${BITCOIN_RPC_USER:-user}
export BITCOIN_RPC_PASSWORD=${BITCOIN_RPC_PASSWORD:-password}
export BITCOIN_ZMQ_HOST=${BITCOIN_ZMQ_HOST:-127.0.0.1}
export BITCOIN_ZMQ_HASHBLOCK_PORT=${BITCOIN_ZMQ_HASHBLOCK_PORT:-28332}
export BITCOIN_ZMQ_HASHTX_PORT=${BITCOIN_ZMQ_HASHTX_PORT:-28333}
export BITCOIN_ZMQ_RAWBLOCK_PORT=${BITCOIN_ZMQ_RAWBLOCK_PORT:-28334}
export BITCOIN_ZMQ_RAWTX_PORT=${BITCOIN_ZMQ_RAWTX_PORT:-28335}
export BITCOIN_ZMQ_SEQUENCE_PORT=${BITCOIN_ZMQ_SEQUENCE_PORT:-28336}
